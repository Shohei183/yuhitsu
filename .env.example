# ── Supabase ──────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 新形式 sb_publishable_… （旧 JWT anon key なら NEXT_PUBLIC_SUPABASE_ANON_KEY でも可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 秘密。サーバー（route handler）専用。クライアントに出さない
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# DDL/マイグレーション適用用（任意・Project Settings → Database → Connection string → URI）
SUPABASE_DB_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ── Cloudflare R2 ────────────────────────────────────────
# R2 → Manage R2 API Tokens で発行
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=yuhitsu-files

# ── サイト URL（招待メールのリダイレクト先など）──────────
# ローカルは http://localhost:3000 、本番は Netlify の URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
