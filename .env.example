# ── Supabase ──────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 秘密。サーバー（route handler）専用。クライアントに出さない
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudflare R2 ────────────────────────────────────────
# R2 → Manage R2 API Tokens で発行
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=yuhitsu-files

# ── サイト URL（招待メールのリダイレクト先など）──────────
# ローカルは http://localhost:3000 、本番は Netlify の URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
